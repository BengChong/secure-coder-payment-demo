# .env.example — copy to .env and fill in real values; NEVER commit .env

# Server
PORT=3000

# IBM Vault
VAULT_ADDR=https://192.168.3.7:8200
VAULT_TOKEN=your_vault_token_here

# Stripe live API key (obtain from Stripe Dashboard — rotate immediately if exposed)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# PostgreSQL credentials (rotate the old credential on 192.168.3.7:5432 immediately)
DB_PASSWORD=your_db_password_here

# JWT signing secret (generate a cryptographically random 256-bit value)
JWT_SECRET=your_jwt_secret_here

# SMTP credentials
SMTP_PASSWORD=your_smtp_password_here

# AWS IAM credentials (prefer IAM roles or AWS Secrets Manager in production)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# GitHub personal access token
GITHUB_TOKEN=your_github_token_here
